{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["github>rakuzen25/jellyfin-plugin-toolkit:tooling#v0.6.3", "github>rakuzen25/jellyfin-plugin-toolkit#v0.6.3"],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": ["/^toolchain\\.json$/"],
            "matchStrings": ["\"gh\":\\s*\"(?<currentValue>[^\"]+)\""],
            "depNameTemplate": "cli/cli",
            "datasourceTemplate": "github-releases",
            "extractVersionTemplate": "^v(?<version>.*)$",
            "versioningTemplate": "semver"
        }
    ]
}
